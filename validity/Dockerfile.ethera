# Ethera build — architecture-aware variant of the validity proposer image.
# Replaces the hardcoded linux-amd64 Go download with a TARGETARCH-driven one so
# the image builds correctly on both x86-64 and ARM64 (Apple Silicon) hosts.
#
# Build args:
#   TARGETARCH        — set automatically by Docker (amd64 / arm64)
#   BUILD_FEATURES    — cargo feature flags (default: "altda" for Ethera stage)

# Build stage
FROM rust:1.85 AS builder

ARG TARGETARCH
ARG BUILD_FEATURES="altda"

# Install build dependencies
RUN apt-get update && apt-get install -y \
    build-essential \
    libclang-dev \
    pkg-config \
    libssl-dev \
    git \
    protobuf-compiler \
    && rm -rf /var/lib/apt/lists/*

# Install Go — use the architecture that matches the build platform so that
# CGO calls the native gcc without x86-only flags like -m64.
RUN curl -LO "https://go.dev/dl/go1.24.0.linux-${TARGETARCH}.tar.gz" && \
    tar -C /usr/local -xzf "go1.24.0.linux-${TARGETARCH}.tar.gz" && \
    rm "go1.24.0.linux-${TARGETARCH}.tar.gz"
ENV PATH="/usr/local/go/bin:${PATH}"

WORKDIR /build

# Install SP1
RUN curl -L https://sp1.succinct.xyz | bash && \
    ~/.sp1/bin/sp1up -v 6.2.4 && \
    ~/.sp1/bin/cargo-prove prove --version

# Copy only what's needed for the build
COPY . .

# Build the validity proposer; Ethera stage uses AltDA, so custom features are
# built without Cargo's default Ethereum DA feature.
RUN --mount=type=ssh \
    --mount=type=cache,target=/root/.cargo/registry \
    --mount=type=cache,target=/build/target \
    if [ -n "${BUILD_FEATURES}" ]; then \
        cargo build --bin validity --release --no-default-features --features "${BUILD_FEATURES}"; \
    else \
        cargo build --bin validity --release; \
    fi && \
    cp target/release/validity /build/validity-proposer

# Final stage
FROM rust:1.85-slim

WORKDIR /app

# Install required runtime dependencies
RUN apt-get update && apt-get install -y \
    curl \
    clang \
    pkg-config \
    libssl-dev \
    ca-certificates \
    git \
    libclang-dev \
    && rm -rf /var/lib/apt/lists/*

# Install SP1
RUN curl -L https://sp1.succinct.xyz | bash && \
    ~/.sp1/bin/sp1up -v 6.2.4 && \
    ~/.sp1/bin/cargo-prove prove --version

COPY --from=builder /build/validity-proposer /usr/local/bin/validity-proposer

# Aggressively release memory to avoid fragmentation under sustained load.
ENV JEMALLOC_SYS_WITH_MALLOC_CONF="background_thread:true,narenas:1,tcache:false,dirty_decay_ms:0,muzzy_decay_ms:0,abort_conf:true"

CMD ["/usr/local/bin/validity-proposer"]
